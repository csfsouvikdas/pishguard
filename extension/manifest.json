{
  "manifest_version": 3,
  "name": "PhishGuard – Phishing Link Checker",
  "version": "1.0.0",
  "description": "Flags suspicious links before you click. Open-source detection logic.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["detector.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": { "gecko": { "id": "phishguard@example.com" } }
}
